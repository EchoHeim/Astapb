---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/url';

// 精选几个最可能想去的地方：找不到页面时，先给出口而不是只报错
const links = [
  { label: '回到首页', href: withBase('') },
  { label: '按标签浏览', href: withBase('tags/') },
  { label: '按时间归档', href: withBase('archive/') },
  { label: '搜索文章', href: withBase('search/') },
];
---

<BaseLayout title="页面不存在" description="404 未找到">
  <div class="wrap">
    <section class="not-found">
      <p class="not-found__code">404</p>
      <p>这个页面不存在，或者已经被挪走了。</p>
      <div class="not-found__links">
        {links.map((l) => <a href={l.href}>{l.label}</a>)}
      </div>
    </section>
  </div>
</BaseLayout>
