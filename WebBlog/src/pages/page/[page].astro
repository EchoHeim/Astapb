---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import Pager from '../../components/Pager.astro';
import Sidebar from '../../components/Sidebar.astro';
import { PAGE_SIZE } from '../../consts';
import { buildTagIndex, buildCategoryTree } from '../../utils/tags';
import { sortPosts } from '../../utils/posts';

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const all = await getCollection('posts', ({ data }) => !data.draft);
  const sorted = sortPosts(all);
  // 第 1 页由 index.astro 负责，这里只产出第 2 页起
  return paginate(sorted, { pageSize: PAGE_SIZE }).slice(1);
};

const { page } = Astro.props;

// 侧栏在每一页都要有，所以这里重新汇总一次（构建期，没有运行时开销）
const all = await getCollection('posts', ({ data }) => !data.draft);
const tags = buildTagIndex(all);
const tree = buildCategoryTree(all);
---

<BaseLayout title={`第 ${page.currentPage} 页`}>
  <div class="wrap">
    <div class="layout">
      <div class="main-col">
        <div class="sec-head">
          <h2>最新文章</h2>
          <span class="sec-head__note">
            共 {page.total} 篇 · 第 {page.currentPage} / {page.lastPage} 页
          </span>
        </div>
        <PostList posts={page.data} />
        <Pager
          currentPage={page.currentPage}
          lastPage={page.lastPage}
          prefix=""
          urlPattern="page/[page]/"
        />
      </div>

      <Sidebar tree={tree} tags={tags} />
    </div>
  </div>
</BaseLayout>
