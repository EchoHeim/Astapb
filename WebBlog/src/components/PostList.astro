---
import PostCard from './PostCard.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'posts'>[];
}

const { posts } = Astro.props;
---

{
  posts.length === 0 ? (
    <p class="empty">这里还没有文章。</p>
  ) : (
    <ul class="post-list">
      {posts.map((post) => (
        <PostCard post={post} />
      ))}
    </ul>
  )
}
