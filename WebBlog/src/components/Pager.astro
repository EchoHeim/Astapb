---
import { withBase } from '../utils/url';

interface Props {
  currentPage: number;
  lastPage: number;
  /** 第一页的地址 */
  prefix?: string;
  /** 第 2 页起的路径模板，[page] 会被替换 */
  urlPattern?: string;
}

const { currentPage, lastPage, prefix = '', urlPattern = 'page/[page]/' } =
  Astro.props;

const hrefFor = (p: number) =>
  p === 1 ? withBase(prefix) : withBase(urlPattern.replace('[page]', String(p)));
---

{
  lastPage > 1 && (
    <nav class="pager" aria-label="分页导航">
      <span class="pager__side">
        {currentPage > 1 ? (
          <a href={hrefFor(currentPage - 1)} rel="prev">
            ← 上一页
          </a>
        ) : (
          <span class="pager__disabled">← 上一页</span>
        )}
      </span>

      <span class="pager__status">
        第 {currentPage} / {lastPage} 页
      </span>

      <span class="pager__side">
        {currentPage < lastPage ? (
          <a href={hrefFor(currentPage + 1)} rel="next">
            下一页 →
          </a>
        ) : (
          <span class="pager__disabled">下一页 →</span>
        )}
      </span>
    </nav>
  )
}
